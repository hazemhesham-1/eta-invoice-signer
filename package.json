{
    "name": "iwomt-eta-invoice-signer",
    "productName": "IWOMT ETA Invoice Signer",
    "version": "1.0.0",
    "description": "Official IWOMT desktop companion application for secure signing and submission of invoices to the Egyptian Tax Authority (ETA) portal.",
    "main": ".vite/build/main.js",
    "private": true,
    "scripts": {
        "start": "electron-forge start",
        "package": "electron-forge package",
        "make": "electron-forge make",
        "publish": "electron-forge publish",
        "lint": "echo \"No linting configured\"",
        "build": "vite build",
        "dist": "npm run build && electron-forge package"
    },
    "keywords": [],
    "author": {
        "name": "Hazem Hesham",
        "email": "eng.hazem.hesham@gmail.com"
    },
    "license": "MIT",
    "devDependencies": {
        "@electron-forge/cli": "^7.11.2",
        "@electron-forge/maker-deb": "^7.11.2",
        "@electron-forge/maker-rpm": "^7.11.2",
        "@electron-forge/maker-squirrel": "^7.11.2",
        "@electron-forge/maker-zip": "^7.11.2",
        "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
        "@electron-forge/plugin-fuses": "^7.11.2",
        "@electron-forge/plugin-vite": "^7.11.2",
        "@electron/fuses": "^1.8.0",
        "@tailwindcss/vite": "^4.3.3",
        "electron": "43.3.0",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "vite": "^8.2.1"
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource/cairo": "^5.3.0",
        "@fontsource/noto-sans": "^5.3.0",
        "@vitejs/plugin-react": "^6.0.5",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dotenv": "^17.4.2",
        "electron-squirrel-startup": "^1.0.1",
        "electron-updater": "^6.8.9",
        "lucide-react": "^1.31.0",
        "pkcs11js": "^2.1.7",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hook-form": "^7.85.0",
        "react-router-dom": "^7.18.2",
        "shadcn": "^4.16.2",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0"
    },
    "build": {
        "appId": "com.iwomt.eta-invoice-signer",
        "productName": "IWOMT ETA Invoice Signer",
        "publish": {
            "provider": "generic",
            "url": "https://updates.iwomt.net/"
        }
    },
    "allowScripts": {
        "pkcs11js@2.1.7": true
    }
